# =========================================================================
# Phase B — read-only monitor (required for the cron + GitHub Actions scan)
# =========================================================================

# 32-byte hex secret. Shared by Vercel (auto-injected on its own cron) and
# the GitHub Actions workflow which calls /api/cron/scan with this bearer.
CRON_SECRET=

# Telegram bot via @BotFather. Used to send arb signal alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Signal thresholds in basis points. Tune after observing real traffic.
THRESHOLD_FX_BPS=80
THRESHOLD_TRI_BPS=15
THRESHOLD_CROSS_BPS=30

# Notional ladder (TWD, comma-separated). Strategies are evaluated at each.
NOTIONAL_TWD_LADDER=100000,500000,2000000

# =========================================================================
# Phase C — signed reads + triangular dry-run
# =========================================================================
# Issued at https://max.maicoin.com/account/api_keys with VIEW + TRADE only.
# DO NOT enable WITHDRAW. safety.ts refuses to start if the key has withdraw.
MAX_ACCESSKEY=
MAX_SECRET=

# =========================================================================
# Phase D — live trading (NOT enabled in this repo version)
# =========================================================================
# All values below are read but ignored until MAX_LIVE=true. Kept for forward
# compatibility — DO NOT flip MAX_LIVE without reviewing docs/phase-gates.md.
MAX_LIVE=false
KILL_SWITCH=false
MAX_NOTIONAL_TWD_PER_CYCLE=50000
MAX_TRADES_PER_DAY=20
MAX_DAILY_LOSS_TWD=2000
MAX_CONSECUTIVE_LOSSES=3
